generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ExamSet {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title         String
  accessible_at DateTime  @db.Timestamptz(6)
  is_public     Boolean   @default(false)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  exams Exam[]

  @@map("exam_sets")
}

model Exam {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  exam_set_id      String    @db.Uuid
  title            String
  subject_code     String
  file_content     String
  accessible_at    DateTime  @db.Timestamptz(6)
  duration_minutes Int       @default(150)
  is_reopened      Boolean   @default(false)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  exam_set     ExamSet      @relation(fields: [exam_set_id], references: [id])
  exam_results ExamResult[]
  exam_sessions ExamSession[]

  @@map("exams")
}

model ExamResult {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String    @db.Uuid
  user_name     String?
  exam_id       String    @db.Uuid
  score         Int
  correct_count Int
  total_count   Int
  answers       Json
  time_taken    Int
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  exam Exam @relation(fields: [exam_id], references: [id])

  @@map("exam_results")
}

model AllowedSurname {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  surname    String   
  is_claimed Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("allowed_surnames")
}


model ExamSession {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  exam_id    String   @db.Uuid
  user_name  String?
  state      Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  exam Exam @relation(fields: [exam_id], references: [id], onDelete: Cascade)

  @@unique([user_id, exam_id])
  @@map("exam_sessions")
}
