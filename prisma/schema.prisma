generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Exam {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String
  subject_code     String
  file_content     String
  accessible_at    DateTime     @db.Timestamptz(6)
  duration_minutes Int          @default(60)
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  
  exam_results     ExamResult[]

  @@map("exams")
}

model ExamResult {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String    @db.Uuid
  exam_id       String    @db.Uuid
  score         Int
  correct_count Int
  total_count   Int
  answers       Json
  time_taken    Int
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  
  exam          Exam      @relation(fields: [exam_id], references: [id])
  // user_id references auth.users in Supabase, but Prisma cannot easily model external schemas out-of-the-box in the same file without multi-schema preview features. 
  // We'll leave it as a regular String/UUID for Prisma's awareness.

  @@map("exam_results")
}
