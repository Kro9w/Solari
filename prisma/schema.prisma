generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Exam {
  id           String   @id @default(uuid())
  title        String
  subjectCode  String
  duration     Int      @default(60) // in minutes
  rawText      String
  accessibleAt DateTime // When the exam becomes available to students
  createdAt    DateTime @default(now())

  results ExamResult[]
}

model ExamResult {
  id        String   @id @default(uuid())
  userId    String // Supabase Auth User ID
  examId    String
  score     Int
  total     Int
  answers   Json // Store granular answers: { "questionId or index": "A", ... }
  createdAt DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id])
}
